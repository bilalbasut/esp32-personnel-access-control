# --- Database ---
DB_NAME=pdks
DB_USER=pdks
DB_PASSWORD=pdks_password
DB_PORT=5432
# DB_HOST is overridden to "postgres" inside docker-compose; used as-is locally.
DB_HOST=127.0.0.1

# --- MQTT ---
# MQTT_HOST is overridden to "mosquitto" inside docker-compose; used as-is locally.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
PORT=3000

# --- App / firmware OTA ---
# Must be a LAN-reachable address, not "localhost" - the ESP32 cannot resolve it.
PANEL_BASE_URL=http://192.168.11.66:3000
TZ_OFFSET_MINUTES=180
REPORT_TZ=Europe/Istanbul
