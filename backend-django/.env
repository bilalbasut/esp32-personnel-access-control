# --- Database ---
# DB_HOST and DB_PORT below are for LOCAL (non-Docker) use only - inside
# docker-compose, both are force-overridden per-service (DB_HOST=postgres,
# DB_PORT=5432) regardless of what's set here, so a locally-convenient value
# here (e.g. matching a remapped host port) can never break the containers.
DB_USER=pdks
DB_PASSWORD=pdks_password
DB_NAME=pdks
DB_HOST=127.0.0.1
DB_PORT=5433

# --- MQTT ---
# MQTT_HOST is overridden to "mosquitto" inside docker-compose; used as-is locally.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
PORT=3000

# --- App / firmware OTA ---
# Must be a LAN-reachable address, not "localhost" - the ESP32 cannot resolve it.
PANEL_BASE_URL=http://192.168.10.124:3000
TZ_OFFSET_MINUTES=180
REPORT_TZ=Europe/Istanbul
